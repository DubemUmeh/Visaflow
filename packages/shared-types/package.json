      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^25.9.1",
    "@visaflow/eslint-config": "workspace:*",
    "@visaflow/typescript-config": "workspace:*",
    "vitest": "^4.1.7"
  }
}
